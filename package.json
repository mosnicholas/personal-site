{
  "name": "personal-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "vercel dev",
    "start:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:likes": "node --import tsx --test api/_lib/likes-*.test.ts",
    "likes:dev": "node --env-file-if-exists=.env.local --import tsx scripts/likes-dev.ts",
    "test:likes:browser": "playwright test --config playwright.likes.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "eval:pick": "node --env-file-if-exists=.env.local --import ./scripts/eval/register.mjs scripts/eval/pick.ts",
    "eval:summarize": "node --env-file-if-exists=.env.local --import ./scripts/eval/register.mjs scripts/eval/summarize.ts",
    "eval:judge": "node --env-file-if-exists=.env.local --import ./scripts/eval/register.mjs scripts/eval/judge.ts",
    "eval:agents": "node --env-file-if-exists=.env.local --import ./scripts/eval/register.mjs scripts/eval/agents.ts",
    "eval:report": "node --env-file-if-exists=.env.local --import ./scripts/eval/register.mjs scripts/eval/report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.9",
    "cheerio": "^1.2.0",
    "d3-force": "^3.0.0",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  },
  "allowScripts": {
    "fsevents": false
  }
}
