# Anthropic API (for chat.ts terminal assistant)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Readwise Reader API
# Get your token at: https://readwise.io/access_token
READWISE_API_KEY=your_readwise_api_key

# Webhook secret for validating incoming Readwise webhooks
# Generate a random string and configure it in Readwise webhook settings
READWISE_WEBHOOK_SECRET=your_webhook_secret

# OpenRouter API (for LLM access - Gemini Flash/Pro)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Resend Email API
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key

# Email recipient for weekly summaries
EMAIL_TO=your_email@example.com

# Optional: Secret for manual cron triggers (used to protect the weekly-summary endpoint)
CRON_SECRET=your_cron_secret
