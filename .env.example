# Anthropic API (terminal chat, tagging, weekly tag rebalance, weekly summary)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Postgres for LLM traces (Neon via the Vercel Marketplace sets this)
# Optional: without it, traces aren't saved and everything else works
DATABASE_URL=your_neon_connection_string

# Readwise Reader API
# Get your token at: https://readwise.io/access_token
READWISE_API_KEY=your_readwise_api_key

# Webhook secret for validating incoming Readwise webhooks (required)
# Readwise generates this when you create the webhook at https://readwise.io/webhook
# Subscribe the webhook to the "reader.any_document.created" event
READWISE_WEBHOOK_SECRET=your_webhook_secret

# Resend Email API (personal account; nimo.fyi is verified there)
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key

# Where the weekly reading summary is emailed (sent from reader@nimo.fyi)
WEEKLY_SUMMARY_RECIPIENT_EMAIL=you@example.com

# Secret for the cron jobs (required in production)
# Generate with: openssl rand -hex 32
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>"; use the same header for manual runs
CRON_SECRET=your_cron_secret

# Private Likes collection. Set these in Vercel before enabling the feature.
# Keep this key server-side; it is also the owner login key and MCP bearer token.
# Generate securely with openssl rand -hex 32; never commit the generated value.
LIKES_API_KEY=
# Optional origin override for tests or custom hosting; Vercel URLs are inferred.
# LIKES_ORIGIN=http://localhost:5173
# Connect a PRIVATE Vercel Blob store; never a public store.
BLOB_READ_WRITE_TOKEN=
# Local development only; rejected on deployed Vercel functions.
# LIKES_LOCAL_DATABASE=/tmp/nimo-likes-local-db
# LIKES_LOCAL_STORAGE=/tmp/nimo-likes-local-files
