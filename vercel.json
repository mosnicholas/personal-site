{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "fluid": true,
  "functions": {
    "api/rebalance-tags.ts": { "maxDuration": 300 },
    "api/weekly-summary.ts": { "maxDuration": 300 }
  },
  "crons": [
    {
      "path": "/api/rebalance-tags",
      "schedule": "0 7 * * 0"
    },
    {
      "path": "/api/weekly-summary",
      "schedule": "0 9 * * 0"
    }
  ]
}
