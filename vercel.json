{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "fluid": true,
  "rewrites": [
    {
      "source": "/reading",
      "destination": "/index.html"
    },
    {
      "source": "/reading/",
      "destination": "/index.html"
    },
    {
      "source": "/likes",
      "destination": "/index.html"
    },
    {
      "source": "/likes/",
      "destination": "/index.html"
    },
    {
      "source": "/api/oauth/:step",
      "destination": "/api/mcp?op=oauth-:step"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/mcp?op=oauth-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api/mcp?op=oauth-server"
    }
  ],
  "crons": [
    {
      "path": "/api/update-prices",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/sync-documents",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/rebalance-tags",
      "schedule": "0 7 * * 0"
    },
    {
      "path": "/api/tag-glossary",
      "schedule": "0 8 * * 0"
    },
    {
      "path": "/api/weekly-summary",
      "schedule": "0 9 * * 0"
    },
    {
      "path": "/api/reading-synthesis",
      "schedule": "0 10 1 * *"
    },
    {
      "path": "/api/likes?op=process",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/likes?op=digest",
      "schedule": "0 12 1 * *"
    }
  ]
}
